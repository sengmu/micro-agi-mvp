# OpenAI-compatible model endpoint; fill in your own provider values.
AI_URL=https://your-provider.example/v1/chat/completions
AI_MODEL=your-model-name
AI_KEY=

# Powerful local terminal endpoint, disabled by default.
ENABLE_SYSTEM_COMMANDS=false

# WeChat remote execution is independent of the local terminal endpoint.
# Set WXCLAW_DEFAULT_TO to the exact authorized sender ID before enabling it.
WXCLAW_DEFAULT_TO=
WXCLAW_ALLOW_FIRST_SENDER_BIND=false
ENABLE_WECHAT_SYSTEM_COMMANDS=false
